# Copy to wrangler.toml and fill in your own values. wrangler.toml is gitignored.
name = "interac"
main = "src/index.ts"
compatibility_date = "2024-09-23"

[[d1_databases]]
binding = "DB"
database_name = "interac"
database_id = "00000000-0000-0000-0000-000000000000"  # from `npx wrangler d1 create interac`
migrations_dir = "migrations"

[vars]
INTERAC_DOMAIN_ALLOWLIST = "payments.interac.ca,interac.ca,notifications.interac.ca"

# Secrets (set via `npx wrangler secret put <NAME>`):
# API_KEY
# WEBHOOK_SIGNING_KEY

# Retry failed webhook deliveries (see src/webhooks.ts retryFailedWebhooks)
[triggers]
crons = ["*/5 * * * *"]
